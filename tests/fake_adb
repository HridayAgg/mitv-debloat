#!/usr/bin/env python3
"""Fake adb for offline tests. Mimics just enough of the Mi TV surface."""
import json
import os
import sys
import zipfile

STATE_FILE = os.environ.get("FAKE_ADB_STATE", "/tmp/mitv-fake-state.json")
HOME = os.environ.get("FAKE_ADB_HOME", "com.mitv.tvhome")

ALL = [
    "com.mitv.tvhome",
    "com.mitv.videoworld",
    "com.mitv.alwaysonvideo",
    "com.mitv.mtservices",
    "com.mitv.shop",
    "com.mitv.appstore",
    "com.mitv.gamecenter",
    "com.mitv.upgrade",
    "com.mitv.tvservice",
    "com.mitv.tvplayer",
    "com.android.tv.settings",
    "com.android.systemui",
    "com.google.android.gms",
    "com.google.android.videos",
    "com.android.vending",
    "com.netflix.ninja",
    "com.example.mysteryapp",
]

PROPS = {
    "ro.product.manufacturer": "Xiaomi",
    "ro.product.brand": "Xiaomi",
    "ro.product.model": "Mi TV 4X",
    "ro.product.device": "oneday",
    "ro.board.platform": "amlogic",
    "ro.build.version.release": "9",
    "ro.build.version.sdk": "28",
    "ro.build.display.id": "PI.2402 release-keys",
    "ro.build.version.incremental": "2402.1",
}


def load():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as fh:
            return set(json.load(fh))
    return set()


def save(removed):
    with open(STATE_FILE, "w") as fh:
        json.dump(sorted(removed), fh)


def apk_path(pkg):
    return "/system/app/%s/%s.apk" % (pkg.split(".")[-1].capitalize(), pkg.split(".")[-1])


def main(argv):
    removed = load()
    if not argv:
        return 2
    if argv[0] == "version":
        print("Android Debug Bridge version 1.0.41")
        return 0
    if argv[0] == "devices":
        print("List of devices attached")
        print("192.168.1.42:5555\tdevice")
        return 0
    if argv[0] == "connect":
        print("connected to %s" % argv[1])
        return 0
    if argv[0] == "pull":
        remote, local = argv[1], argv[2]
        os.makedirs(os.path.dirname(local) or ".", exist_ok=True)
        with zipfile.ZipFile(local, "w") as zf:
            zf.writestr("AndroidManifest.xml", b"\x03\x00\x08\x00android.permission.INTERNET")
            zf.writestr(
                "classes.dex",
                b"dex\n035\x00" + b"\x00" * 64 + b"com/applovin/sdk/AdService"
                b"com/bytedance/sdk/openadsdk/TTAdSdk com/google/android/gms/ads/AdView",
            )
        print("1 file pulled")
        return 0
    if argv[0] != "shell":
        return 2
    cmd = argv[1] if len(argv) > 1 else ""

    if cmd == "getprop":
        for k, v in PROPS.items():
            print("[%s]: [%s]" % (k, v))
        return 0
    if cmd.startswith("pm list packages"):
        flags = cmd
        pkgs = [p for p in ALL if p not in removed] if "-u" not in flags else list(ALL)
        for p in pkgs:
            if "-f" in flags:
                print("package:%s=%s" % (apk_path(p), p))
            else:
                print("package:%s" % p)
        return 0
    if cmd.startswith("pm uninstall"):
        pkg = cmd.split()[-1]
        if pkg in ("com.google.android.gms", "com.mitv.tvservice", "com.android.systemui"):
            print("Failure [DELETE_FAILED_INTERNAL_ERROR]")
            return 0
        removed.add(pkg)
        save(removed)
        print("Success")
        return 0
    if "install-existing" in cmd:
        pkg = cmd.split()[-1]
        removed.discard(pkg)
        save(removed)
        print("Package %s installed for user: 0" % pkg)
        return 0
    if "resolve-activity" in cmd:
        print("priority=0 preferredOrder=0 match=0x108000 specificIndex=-1")
        print("%s/.MainActivity" % HOME)
        return 0
    if cmd.startswith("pm path"):
        pkg = cmd.split()[-1]
        print("package:%s" % apk_path(pkg))
        return 0
    if cmd.startswith("settings list"):
        print("adb_enabled=1")
        return 0
    if cmd.startswith("settings put"):
        return 0
    if "set-home-activity" in cmd:
        print("Success")
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
